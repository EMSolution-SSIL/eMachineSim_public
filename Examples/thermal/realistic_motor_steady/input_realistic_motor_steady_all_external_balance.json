      "turns_per_slot": 35,
      "slots": 24,
      "poles": 4,
      "modeled_length_ratio": 1.0,
      "coil_fill_factor": 0.35,
      "distribution": "uniform_by_target_volume"
    },
    {
      "name": "pm_magnet_loss",
      "mode": "total_heat",
      "target": { "property_ids": [50000] },
      "total_heat": 5.0,
      "modeled_fraction": 0.25,
      "distribution": "uniform_by_target_volume"
    }
  ],
