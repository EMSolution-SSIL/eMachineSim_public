{
  "metaData": {
    "type" : "eMachineSimInput",
		"eMachineSimVersion" : "0.1.0",
    "comments": "Realistic motor steady sample: all external FEMH balance check with BDF QVOL, coil copper loss, and PM magnet loss."
  },
