    "MAT_POINTS": 1
  },
  "mesh": {
    "format": "nastran_bdf",
    "file": "../QVOL_loss_mix.bdf"
  },
  "bdf_import": {
    "material_source": "json",
    "bulk_sections": {
      "0": "stator",
      "1": "rotor"
